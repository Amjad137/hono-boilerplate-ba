{
  "name": "easna-api",
  "description": "EASNA API",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "node ./dist/index.js",
    "start:local": "yarn env:copy:local && yarn build:watch --onSuccess \"node ./dist/index.js\"",
    "start:qa": "yarn env:copy:qa && yarn build:watch --onSuccess \"node ./dist/index.js\"",
    "start:production": "yarn env:copy:production && yarn build:watch --onSuccess \"node ./dist/index.js\"",
    "build": "tsup src/index.ts",
    "build:check": "tsc --noEmit",
    "build:watch": "tsup src/index.ts --watch",
    "test": "jest --coverage --detectOpenHandles --passWithNoTests",
    "test:watch": "jest --coverage --watch --detectOpenHandles",
    "env:copy:local": "cp .env.local .env",
    "env:copy:test": "cp .env.test .env",
    "env:copy:qa": "cp .env.qa .env",
    "env:copy:production": "cp .env.production .env",
    "initiate:replica": "run-rs -v 7.0.0 --keep --shell",
    "lint": "yarn eslint .",
    "lint:fix": "yarn eslint . --fix",
    "format": "yarn prettier --check .",
    "format:fix": "yarn prettier --write .",
    "migrate:status": "yarn migrate-mongo status",
    "migrate:up": "yarn migrate-mongo up",
    "migrate:down": "yarn migrate-mongo down",
    "migrate:create": "sh -c 'echo \"Enter description using dashes(-):\" && read description && npx migrate-mongo create \"$description\"'",
    "postinstall": "husky || true",
    "release:patch": "yarn version --patch && yarn extract",
    "release:minor": "yarn version --minor && yarn extract",
    "release:major": "yarn version --major && yarn extract",
    "kill": "echo 'Enter port number' && read port && kill $(lsof -t -i:$port)",
    "extract": "node -p \"'export const VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts && yarn format:fix && git add . && git commit -m 'build: version update' && git push --tags"
  },
  "author": "Amjath husain",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.832.0",
    "@aws-sdk/s3-request-presigner": "^3.832.0",
    "@better-auth/mongo-adapter": "^1.6.10",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.2.2",
    "@react-email/components": "^1.0.11",
    "better-auth": "^1.4.10",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^11.0.6",
    "hono": "^4.6.13",
    "http-status-codes": "^2.3.0",
    "lodash": "^4.17.21",
    "mongoose": "^8.8.4",
    "nanoid": "^5.1.5",
    "react": "^19.2.6",
    "resend": "^6.12.3",
    "yup": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@faker-js/faker": "^9.9.0",
    "@types/lodash": "^4",
    "@types/node": "^20.11.17",
    "@types/react": "^19",
    "eslint": "^9.16.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "migrate-mongo": "^11.0.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=4.3.0"
  },
  "packageManager": "yarn@4.5.3",
  "tsup": {
    "clean": true,
    "format": "esm",
    "target": "node20",
    "outDir": "dist",
    "minify": true,
    "treeShake": true,
    "entry": [
      "src/index.ts"
    ]
  }
}
